// token_kinds.def

// All language keywords are as follows:
// 	uint8 uint16 uint32 uint64 uint int8 int16 int32 int64 int float32 float64 char string cstring 
//  pstring void boolean address auto enum func class if elif else do while loop before during then 
//  for in try recover failure switch case default goto label break continue return public private 
//  protected module import export static extern inherits this alias as ptr ref deref addrof 
//  overload create delete and or not xor rotateleft rotateright nil sizeof lengthof true false null

#ifndef TOKEN
#define TOKEN(x, y)
#endif

// Delimeters

TOKEN( x, TOKEN_EOF)
TOKEN( x, TOKEN_COMMENT)
TOKEN( x, TOKEN_UNKNOWN)
TOKEN( x, TOKEN_RESERVED)
TOKEN( x, TOKEN_IDENTIFIER)
TOKEN( x, TOKEN_STRING_LITERAL)
TOKEN( x, TOKEN_NUMERIC_LITERAL)

// Reserved

TOKEN(uint8, TOKEN_UINT8)
TOKEN(uint16, TOKEN_UINT16)
TOKEN(uint32, TOKEN_UINT32)
TOKEN(uint64, TOKEN_UINT64)
TOKEN(uint, TOKEN_UINT)
TOKEN(int8, TOKEN_INT8)
TOKEN(int16, TOKEN_INT16)
TOKEN(int32, TOKEN_INT32)
TOKEN(int64, TOKEN_INT64)
TOKEN(int, TOKEN_INT)
TOKEN(float32, TOKEN_FLOAT32)
TOKEN(float64, TOKEN_FLOAT64)
TOKEN(char, TOKEN_CHAR)
TOKEN(string, TOKEN_STRING)
TOKEN(cstring, TOKEN_CSTRING)
TOKEN(pstring, TOKEN_PSTRING)
TOKEN(void, TOKEN_VOID)
TOKEN(boolean, TOKEN_BOOLEAN)
TOKEN(address, TOKEN_ADDRESS)
TOKEN(auto, TOKEN_AUTO)
TOKEN(enum, TOKEN_ENUM)
TOKEN(func, TOKEN_FUNC)
TOKEN(class, TOKEN_CLASS)
TOKEN(if, TOKEN_IF)
TOKEN(elif, TOKEN_ELIF)
TOKEN(else, TOKEN_ELSE)
TOKEN(do, TOKEN_DO)
TOKEN(while, TOKEN_WHILE)
TOKEN(loop, TOKEN_LOOP)
TOKEN(before, TOKEN_BEFORE)
TOKEN(during, TOKEN_DURING)
TOKEN(then, TOKEN_THEN)
TOKEN(for, TOKEN_FOR)
TOKEN(in, TOKEN_IN)
TOKEN(try, TOKEN_TRY)
TOKEN(recover, TOKEN_RECOVER)
TOKEN(failure, TOKEN_FAILURE)
TOKEN(switch, TOKEN_SWITCH)
TOKEN(case, TOKEN_CASE)
TOKEN(default, TOKEN_DEFAULT)
TOKEN(goto, TOKEN_GOTO)
TOKEN(label, TOKEN_LABEL)
TOKEN(break, TOKEN_BREAK)
TOKEN(continue, TOKEN_CONTINUE)
TOKEN(return, TOKEN_RETURN)
TOKEN(public, TOKEN_PUBLIC)
TOKEN(private, TOKEN_PRIVATE)
TOKEN(protected, TOKEN_PROTECTED)
TOKEN(module, TOKEN_MODULE)
TOKEN(import, TOKEN_IMPORT)
TOKEN(export, TOKEN_EXPORT)
TOKEN(static, TOKEN_STATIC)
TOKEN(extern, TOKEN_EXTERN)
TOKEN(inherits, TOKEN_INHERITS)
TOKEN(this, TOKEN_THIS)
TOKEN(alias, TOKEN_ALIAS)
TOKEN(as, TOKEN_AS)
TOKEN(ptr, TOKEN_PTR)
TOKEN(ref, TOKEN_REF)
TOKEN(deref, TOKEN_DEREF)
TOKEN(addrof, TOKEN_ADDROF)
TOKEN(overload, TOKEN_OVERLOAD)
TOKEN(create, TOKEN_CREATE)
TOKEN(delete, TOKEN_DELETE)
// TOKEN(and, TOKEN_AND)
// TOKEN(or, TOKEN_OR)
// TOKEN(not, TOKEN_NOT)
// TOKEN(xor, TOKEN_XOR)
// TOKEN(rotateleft, TOKEN_ROTATELEFT)
// TOKEN(rotateright, TOKEN_ROTATERIGHT)
TOKEN(nil, TOKEN_NIL)
TOKEN(sizeof, TOKEN_SIZEOF)
TOKEN(lengthof, TOKEN_LENGTHOF)
TOKEN(true, TOKEN_TRUE)
TOKEN(false, TOKEN_FALSE)
TOKEN(null, TOKEN_NULL)

// Operators

TOKEN( , TOKEN_PLUS)
TOKEN( , TOKEN_HYPHEN)
TOKEN( , TOKEN_ASTERISK)
TOKEN( , TOKEN_SLASH)
TOKEN( , TOKEN_MODULO)
TOKEN( , TOKEN_BIT_AND)
TOKEN( , TOKEN_BIT_OR)
TOKEN( , TOKEN_BIT_XOR)
TOKEN( , TOKEN_BIT_NOT)
TOKEN( , TOKEN_ROTATE_LEFT)
TOKEN( , TOKEN_ROTATE_RIGHT)
TOKEN( , TOKEN_LEFTSHIFT)
TOKEN( , TOKEN_RIGHTSHIFT)
TOKEN( , TOKEN_ASSIGN_PLUS)
TOKEN( , TOKEN_ASSIGN_MINUS)
TOKEN( , TOKEN_ASSIGN_MULTIPLY)
TOKEN( , TOKEN_ASSIGN_DIVIDE)
TOKEN( , TOKEN_ASSIGN_MODULO)
TOKEN( , TOKEN_ASSIGN_BIT_AND)
TOKEN( , TOKEN_ASSIGN_BIT_OR)
TOKEN( , TOKEN_ASSIGN_BIT_XOR)
TOKEN( , TOKEN_ASSIGN_BIT_NOT)
TOKEN( , TOKEN_ASSIGN_LEFTSHIFT)
TOKEN( , TOKEN_ASSIGN_RIGHTSHIFT)
TOKEN( , TOKEN_INCREMENT)
TOKEN( , TOKEN_DECREMENT)
TOKEN( , TOKEN_INITIALIZE)
TOKEN( , TOKEN_ASSIGN)
TOKEN( , TOKEN_ARROW)
TOKEN( , TOKEN_ARROW_POINTER)
TOKEN( , TOKEN_BACK_ARROW)
TOKEN( , TOKEN_PERIOD)
TOKEN( , TOKEN_SCOPE_RESOLUTION)
TOKEN( , TOKEN_ELIPSIS)
TOKEN( , TOKEN_AND)
TOKEN( , TOKEN_OR)
TOKEN( , TOKEN_NOT)
TOKEN( , TOKEN_GT)
TOKEN( , TOKEN_LT)
TOKEN( , TOKEN_GTOEQ)
TOKEN( , TOKEN_LTOEQ)
TOKEN( , TOKEN_EQ)
TOKEN( , TOKEN_NEQ)
TOKEN( , TOKEN_CONDITIONAL)
TOKEN( , TOKEN_ELVIS)
TOKEN( , TOKEN_CONDITIONAL_ASSIGN)

// int ptr x = int*
// (int ptr) ptr x = int**

// func main(int x : 5, int y : 10) -> int
// fn main(u32 x : 5, u32 y : 10) -> int